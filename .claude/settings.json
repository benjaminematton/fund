{
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(~/.ssh/**)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push origin :*)",
      "Bash(git push --delete *)",
      "Bash(git push origin --delete *)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .*)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git branch -f *)",
      "Bash(git branch --force *)",
      "Bash(git worktree remove --force*)",
      "Bash(git worktree prune*)",
      "Bash(git filter-branch*)",
      "Bash(git update-ref -d *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rm -fr *)"
    ],
    "ask": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(systemctl *)",
      "Bash(curl *)",
      "Bash(gh api *)",
      "Bash(gh repo *)",
      "Bash(make live-paper*)",
      "Bash(make deploy*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null); f=\"$r/scripts/hooks/commit_gate.py\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/commit_gate.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=$(git rev-parse --show-toplevel 2>/dev/null); f=\"$r/scripts/hooks/stop_gate.py\"; [ -f \"$f\" ] || f=\"$CLAUDE_PROJECT_DIR/scripts/hooks/stop_gate.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
