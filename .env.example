# fund — environment template. Copy to .env; NEVER commit .env.
# `make test` must pass with NONE of these set. Load with:
#     set -a; source .env; set +a
# Every var below is read by real code; nothing here is aspirational.
#
# --- .env vs .env.eval ---
# `make eval` reads .env.eval in preference to .env. It carries ONLY the four
# keys an eval turn needs (Anthropic + read-only Alpaca + ALPACA_PAPER_TRADE),
# never FUND_DB or a Slack token — so a host that can measure charters still
# cannot run a trading day: run_day.py refuses on its own REQUIRED_ENV.
# That gap is what lets eval credentials live on a machine deliberately taken
# out of the trading path (the Mac after the 2026-08-18 droplet cutover), and
# tests/test_eval_env_cannot_trade.py fails if it ever closes.
# Use a full .env only on the host that actually trades.

# --- Anthropic (Agent SDK runtime; Console API key, not a subscription) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Alpaca (paper ONLY — invariant 1) ---
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...
ALPACA_PAPER_TRADE=true            # never false; live is not a config flip

# --- State ---
FUND_DB=state/fund.sqlite          # SQLite source of truth (invariant 6)
FUND_JOURNALS=journals             # optional; per-agent markdown, defaults to ./journals

# --- Slack: ONE app, outbox-only, no Socket Mode listeners (MVF review A4) ---
SLACK_BOT_TOKEN=xoxb-...           # bot token; xapp- app tokens CANNOT post
# Optional channel remap for a rehearsal day, comma-separated '#from=#to'. The
# droplet's staging environment redirects all five to #fund-staging — see
# ops/staging-env.example, which is the copy that is actually used:
#   SLACK_CHANNEL_OVERRIDES=#pnl=#fund-staging,#risk=#fund-staging
SLACK_CHANNEL_OVERRIDES=
# Read only by the @live smoke (tests/test_live_smoke.py), which asserts the
# Slack leg separately from the order round-trip. Usually the same value as
# SLACK_BOT_TOKEN.
SLACK_BOT_TOKEN_EXEC=xoxb-...

# App-per-seat tokens, the CEO approval ping and the analyst start stagger
# return in Phase 3 (design.md §4). MVF reads none of them — left out of this
# template on purpose so nothing here is a lie.
