# fund — environment template. Copy to .env; NEVER commit .env.
# make test must pass with NONE of these set.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Alpaca (paper ONLY — invariant 1) ---
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...
ALPACA_PAPER_TRADE=true            # never false; live is not a config flip

# --- Slack: one app per seat (Socket Mode; xoxb = bot token, xapp = app token) ---
SLACK_BOT_TOKEN_PM=xoxb-...
SLACK_APP_TOKEN_PM=xapp-...
SLACK_BOT_TOKEN_FUNDAMENTALS=xoxb-...
SLACK_APP_TOKEN_FUNDAMENTALS=xapp-...
SLACK_BOT_TOKEN_TECHNICAL=xoxb-...
SLACK_APP_TOKEN_TECHNICAL=xapp-...
SLACK_BOT_TOKEN_NEWS=xoxb-...
SLACK_APP_TOKEN_NEWS=xapp-...
SLACK_BOT_TOKEN_MACRO=xoxb-...
SLACK_APP_TOKEN_MACRO=xapp-...
SLACK_BOT_TOKEN_BULL=xoxb-...
SLACK_APP_TOKEN_BULL=xapp-...
SLACK_BOT_TOKEN_BEAR=xoxb-...
SLACK_APP_TOKEN_BEAR=xapp-...
SLACK_BOT_TOKEN_QUANT=xoxb-...
SLACK_APP_TOKEN_QUANT=xapp-...
SLACK_BOT_TOKEN_CRITIC=xoxb-...
SLACK_APP_TOKEN_CRITIC=xapp-...
SLACK_BOT_TOKEN_RISK=xoxb-...
SLACK_APP_TOKEN_RISK=xapp-...
SLACK_BOT_TOKEN_EXEC=xoxb-...
SLACK_APP_TOKEN_EXEC=xapp-...
SLACK_BOT_TOKEN_OPS=xoxb-...
SLACK_APP_TOKEN_OPS=xapp-...
SLACK_CEO_USER_ID=U...             # your Slack user id, for approval pings

# --- State ---
DB_PATH=/data/fund.sqlite
JOURNALS_DIR=/data/journals
RECORDINGS_DIR=/data/recordings
TZ=America/New_York

# --- Budgets (USD, per seat per session; enforced via max_budget_usd) ---
BUDGET_FAST_SEAT=1.00
BUDGET_STRONG_SEAT=3.00
CEO_APPROVAL_ORDER_USD=10000       # orders above this block on your ✅

# --- Pacing ---
ANALYST_START_DELAY_S=20           # stagger parallel analyst starts (API rate limits)
