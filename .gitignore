# secrets — never commit
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.pytest_cache/
.venv
.venv/
venv/
*.egg-info/
dist/
build/

# runtime state (volumes; SQLite is the source of truth but not in git)
*.sqlite
*.sqlite3
*.db
# WAL mode (state/db.py sets journal_mode=WAL) writes these alongside the db
# run_day's flock handle (scripts/run_day.py acquire_lock)
*.lock
# ...but the dependency lock is the one file every host must receive.
!requirements.lock
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
data/
journals/*
!journals/.gitkeep
recordings/*
!recordings/.gitkeep
logs/*
!logs/.gitkeep

# os / editor
.DS_Store
.idea/
.vscode/

# Claude Code local approvals — personal, never shared. A committed allow-list
# would grant one dev's Bash approvals to everyone's seats. Project-shared
# settings (if ever needed) go in .claude/settings.json, reviewed like code.
.claude/settings.local.json

# Agent worktrees. Never tracked: a worktree holds a full second checkout, so
# a stray `git add -A` on master would commit the whole tree into itself.
.claude/worktrees/

# Per-trial eval scratch: temp SQLite DBs and journals, one dir per trial.
# 2.3MB per suite run and meaningless once the trace is written. Traces
# themselves ARE tracked (evals/traces/) — they are the baseline artifact.
evals/_work/

# snapshots pulled from the VM (runtime state, never code)
backups-from-vm/

# subagent-driven-development bookkeeping: task briefs, per-task reports, the
# progress ledger. Controller scratch for one branch's execution, not repo
# content — one report reached a commit before this entry existed.
sdd/
