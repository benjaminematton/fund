# secrets — never commit
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
dist/
build/

# runtime state (volumes; SQLite is the source of truth but not in git)
*.sqlite
*.sqlite3
*.db
data/
journals/*
!journals/.gitkeep
recordings/*
!recordings/.gitkeep

# os / editor
.DS_Store
.idea/
.vscode/

# Claude Code local approvals — personal, never shared. A committed allow-list
# would grant one dev's Bash approvals to everyone's seats. Project-shared
# settings (if ever needed) go in .claude/settings.json, reviewed like code.
.claude/settings.local.json
