[Unit]
Description=fund — post-close jobs (P&L $ and %% vs SPY; nightly resolutions)
Documentation=file:///opt/fund/ops/README.md
OnFailure=fund-alert@%n.service

[Service]
Type=oneshot
User=fund
Group=fund
WorkingDirectory=/opt/fund
EnvironmentFile=/etc/fund/env
# uvx lives in ~/.local/bin, which is NOT on systemd's default PATH
# (/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin). agents/seats.py:49
# hardcodes `uvx alpaca-mcp-server`, so without this the MCP server never
# connects and every seat refuses to run — 2026-08-18's lost day. A login
# shell finds uvx via the profile, which is why validating with `su - fund`
# missed it.
Environment=PATH=/home/fund/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/opt/fund/.venv/bin/python3 /opt/fund/scripts/close_pnl.py
# The nightly reflection job shares this unit because it shares its one timing
# constraint: close_frame's SIP_DELAY shift means an earlier fire asks for a
# bar the closing auction has not written. Type=oneshot runs ExecStart lines in
# order and stops at the first failure, so a broken P&L post holds back the
# resolutions write — acceptable, since both are retried on the next fire and
# resolve_day selects only what is still outstanding.
ExecStart=/opt/fund/.venv/bin/python3 /opt/fund/scripts/resolve_day.py
TimeoutStartSec=10min
